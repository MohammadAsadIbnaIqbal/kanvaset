# ==============================================================================
# Kanvaset Configuration
# ==============================================================================

# Application Environment: 'development', 'production', 'testing'
ENVIRONMENT=development
PROJECT_NAME="Kanvaset"
API_V1_STR=/api/v1

# Security & Authentication
# Generate a secure key in production: openssl rand -hex 32
SECRET_KEY=kanvaset_dev_super_secret_key_change_in_production_987654321
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL in production, SQLite fallback in local tests)
POSTGRES_SERVER=localhost
POSTGRES_USER=kanvaset
POSTGRES_PASSWORD=kanvaset_secret
POSTGRES_DB=kanvaset_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kanvaset:kanvaset_secret@localhost:5432/kanvaset_db

# Redis Cache & Pub/Sub (fallback to in-memory event bus if offline)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
